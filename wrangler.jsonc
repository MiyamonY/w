{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "words",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OPENAI_MODEL": "gpt-6-luna",
    "OPENAI_IMAGE_MODEL": "gpt-image-2.5-flare",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "words",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "words-audio",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
}
