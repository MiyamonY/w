{
  "name": "words",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file seed.sql",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "htmx.org": "2.0.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@tailwindcss/vite": "^4.3.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@12.6.0"
}
